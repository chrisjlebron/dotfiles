###############################################################################
### fzf

# fuzzy finder interactive selection
# Ctrl-t searches files and directories.
# Ctrl-r launches interactive history search
# Alt-c lists nested directories for navigation.
# (and fuzzy completion with `**<TAB>, e.g. cd d**<TAB> -> filtered list of files/dirs starting with "d")

# DISABLE Ctrl-r (atuin owns this)
export FZF_CTRL_R_COMMAND=

export FZF_DEFAULT_OPTS='--height ~75% --layout reverse --border top'

source <(fzf --zsh)

# fix disappearing variable prefix in the quoted variable case: e.g. `mv "$my_d<tab>` was resulting in `mv `
# fzf_default_completion=complete-word

### end fzf
