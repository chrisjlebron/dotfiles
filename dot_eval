###############################################################################
### deja

# smarter autosuggest (installed via brew, config'd in .exports)
# NOTE: Sourcing the cached script keeps deja off your shell startup path;
# the eval is only the first-run bootstrap, and deja refreshes the file itself when you upgrade
if [[ -r "$HOME/.local/share/deja/init.zsh" ]]; then
  source "$HOME/.local/share/deja/init.zsh"
else
  eval "$(deja init zsh)"
fi

### end deja
