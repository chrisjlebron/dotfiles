###############################################################################
### compinit & styling

# define some reused vars
_zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
_managed_completion_dir="$HOME/.zsh/completions"

# Load managed completions before vendor-provided completions.
typeset -U fpath
if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi

# prepend above homebrew
fpath=("$_managed_completion_dir" $fpath)

autoload -Uz compinit

# Reuse the dump while checking completion file count and zsh version on startup.
# Changes to #compdef headers or provider priority require explicit cache invalidation.
compinit -d "$_zcompdump"

# Reuse existing completion providers for alternate executable names.
if (( ${+functions[_yarn]} )); then
  compdef _yarn yarnpkg
fi
if (( ${+functions[_bundle]} )); then
  compdef _bundle bundler
fi
if (( ${+functions[_bd]} )); then
  compdef _bd beads
fi

unset _zcompdump _managed_completion_dir

# Completion styling & behavior (applies to all terminals)
zstyle ':completion:*' menu select
zstyle ':completion:*' rehash true
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' completer _complete _match _approximate
zstyle ':completion:*:descriptions' format '%F{yellow}%d%f'
zstyle ':completion:*:messages' format '%F{blue}%d%f'
zstyle ':completion:*:warnings' format '%F{red}%d%f'
zstyle ':completion:*:*:ls:*:*' file-patterns \
  '*(-/):directories' \
  '*:all-files'

### end compinit & styling
