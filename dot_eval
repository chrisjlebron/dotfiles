###############################################################################
### completion UI and widget wrappers

# fzf-tab must load after compinit and anything else that binds Tab, but before
# plugins such as fast-syntax-highlighting and Deja that wrap ZLE widgets.
if [[ -n "${ZSH_VERSION:-}" ]]; then
  if (( ${+functions[antidote]} )); then
    _fzf_tab_dir="$(antidote path Aloxaf/fzf-tab 2>/dev/null)"
    if [[ -r "${_fzf_tab_dir}/fzf-tab.plugin.zsh" ]] && (( ${+functions[compdef]} )); then
      # shellcheck source=/dev/null
      source "${_fzf_tab_dir}/fzf-tab.plugin.zsh"

      # Let fzf-tab own the selection menu and preserve completion groups.
      zstyle ':completion:*' menu no
      # set descriptions format to enable group support
      # NOTE: don't use escape sequences (like '%F{red}%d%f') here, fzf-tab will ignore them
      zstyle ':completion:*:descriptions' format '[%d]'
      # disable sort when completing `git checkout`
      zstyle ':completion:*:git-checkout:*' sort false

      # preview directory's content with eza when completing cd and z
      # NOTE: option strings expand now; $realpath remains deferred until preview.
      zstyle ':fzf-tab:complete:(cd|z):*' fzf-preview "[[ -n \"\$realpath\" ]] && eza $EZA_PREVIEW_OPTS -- \"\$realpath\""
      # contextual previews: directories via eza, regular files via bat; empty
      # or non-path candidates produce no output and exit successfully, and
      # missing eza/bat naturally surface command-not-found errors.
      zstyle ':fzf-tab:complete:(ls|eza|cp|mv|rm|nvim|n):*' fzf-preview "if [[ -d \"\$realpath\" ]]; then
        eza $EZA_PREVIEW_OPTS -- \"\$realpath\"
      elif [[ -f \"\$realpath\" ]]; then
        bat $BAT_PREVIEW_OPTS -- \"\$realpath\"
      fi"
      # Account for the top border inherited from FZF_DEFAULT_OPTS so fzf-tab's
      # calculated height leaves room to display every completion candidate.
      zstyle ':fzf-tab:*' fzf-pad 3
      # custom fzf flags
      # NOTE: fzf-tab does not follow FZF_DEFAULT_OPTS by default
      zstyle ':fzf-tab:*' fzf-flags --color=fg:1,fg+:2 --bind=tab:accept
      # To make fzf-tab follow FZF_DEFAULT_OPTS.
      # NOTE: This may lead to unexpected behavior since some flags break this plugin. See Aloxaf/fzf-tab#455.
      zstyle ':fzf-tab:*' use-fzf-default-opts yes
      # switch group using `<` and `>`
      zstyle ':fzf-tab:*' switch-group '<' '>'

      if [[ -n "${LS_COLORS:-}" ]]; then
        # set list-colors to enable filename colorizing
        # shellcheck disable=SC2086,SC2296 # zsh split expansion
        zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
      fi
    fi

    if [[ "${LIGHT_SHELL:-0}" != "1" ]]; then
      _syntax_highlighting_dir="$(antidote path zdharma-continuum/fast-syntax-highlighting 2>/dev/null)"
      if [[ -r "${_syntax_highlighting_dir}/fast-syntax-highlighting.plugin.zsh" ]]; then
        # shellcheck source=/dev/null
        source "${_syntax_highlighting_dir}/fast-syntax-highlighting.plugin.zsh"
      fi
    fi
  fi
  unset -v _fzf_tab_dir _syntax_highlighting_dir
fi

### end completion UI and widget wrappers
