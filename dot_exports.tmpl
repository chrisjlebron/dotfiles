###############################################################################
### language

# Prefer US English and use UTF-8
export LC_ALL="en_US.UTF-8"
export LANG="en_US"

### end language
###############################################################################


###############################################################################
### vim

# vim as default
export EDITOR="vim"

### end vim
###############################################################################


###############################################################################
### less

# Don’t clear the screen after quitting a manual page
export MANPAGER="less -X"

### end less
###############################################################################


###############################################################################
### homebrew

# Where to put items installed via brew cask
# You will likely want to set this before running install
# NOTE: 1password Chrome extension needs to be co-located with Chrome itself,
# so make sure those get installed side-by-side
# NOTE: /Applications is the default applications directory
export HOMEBREW_CASK_OPTS="--appdir=~/Applications --fontdir=/Library/Fonts"

### end homebrew
###############################################################################


###############################################################################
### bat

# Set theme for `bat`, the `cat` replacement; `bat --list-themes` for more...
export BAT_THEME="Coldark-Dark"

### end bat
###############################################################################


###############################################################################
### starship prompt config

# set up prompt with starship
## Use different setup for Warp ##
if [[ $TERM_PROGRAM == "WarpTerminal" ]]; then
  export STARSHIP_CONFIG=~/.starship-config-warp.toml
else
  export STARSHIP_CONFIG=~/.starship-config.toml
fi

### end starship prompt config
###############################################################################


###############################################################################
### mise

MISE_NODE_VERIFY=true
MISE_NODE_COREPACK=true

### end mise
###############################################################################


###############################################################################
### 1password

# 1password biometric toggle
export OP_BIOMETRIC_UNLOCK_ENABLED=true

### end 1password
###############################################################################


###############################################################################
### user configs

# cross-platform standard for user-level app & tool configs
export XDG_CONFIG_HOME="$HOME/.config"

### end user configs
###############################################################################


###############################################################################
### deja (autosuggest)

# REF: https://github.com/Giammarco-Ferranti/deja

# keybindings
export DEJA_CYCLE_KEY='^I'                 # cycle alternatives (default='^I' → Tab)
export DEJA_TOGGLE_KEY='^X'                # suppress for the session (default='^X' → Ctrl+X)
export DEJA_CYCLE_FUZZY_KEY=               # next fuzzy preset (default='^[[1;2C' → Shift+→)
export DEJA_CYCLE_FUZZY_BACK_KEY=          # previous fuzzy preset (default='^[[1;2D' → Shift+←)
export DEJA_TOGGLE_EMPTY_KEY=              # flip empty-prompt suggestions (default='^[[1;2A' → Shift+↑)
# these are unbound by default (→ and Ctrl+→ already accept via wrapped widgets):
export DEJA_ACCEPT_KEY=                    # accept full suggestion on a dedicated key (default=<UNSET>)
export DEJA_WORD_ACCEPT_KEY=               # accept the next word on a dedicated key (default=<UNSET>)
export DEJA_DISMISS_KEY=                   # clear the ghost for this line only (default=<UNSET>)

# settings
export DEJA_FUZZY=smart                    # how loose is the fuzzy matcher (default=smart → 4 chars look-ahead/behind)
export DEJA_EMPTY=off                      # whether to suggest on empty prompt (default=on)

### end deja (autosuggest)
###############################################################################


