###############################################################################
### zsh profiling defaults

# Only set a default if not already defined in the environment
if [[ -z "${ZSH_STARTUP_PROFILE+x}" ]]; then
  export ZSH_STARTUP_PROFILE=0
fi

### end zsh profiling defaults
