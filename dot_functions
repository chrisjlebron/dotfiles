#################################################
# Cleanup git branches
#################################################

# first remove conflicting alias (if it exists, e.g. from a git-alias plugin)
if alias gbda > /dev/null 2>&1; then
  unalias gbda
fi
# Now the function "alias"
gbda () {
  echo "pruning..."
  git remote prune origin
  echo "deleting orphaned local branches..."
  git branch -vv | grep 'origin/.*: gone]' | awk '{print $1}' | xargs git branch -D
}


#################################################
# Better diff
#################################################

# use diff-so-fancy for diffs
# NOTE: this overrides native `diff` command
alias diff_native='command diff'
diff () {
  command diff -burN -- "$@" | diff-so-fancy
}

#################################################
# Safe delete
#################################################

alias rm_native='command rm'
rm () {
  echo "Using aliased rm -> macOS trash"
  echo "Use rm_native for native rm"

  # Check if trash tool is already installed, install if not
  if ! command -v trash >/dev/null; then
    echo "macos-trash not installed. Installing..."
    brew install macos-trash
  fi

  # Filter out all flags except for -v
  local args=()
  for arg in "$@"; do
    if [[ "$arg" == -* ]]; then
      if [[ "$arg" == *v* ]]; then
        args+=("-v")
      else
        echo "Ignoring unsupported flag(s) in: $arg"
      fi
    else
      args+=("$arg")
    fi
  done

  trash "${args[@]}"
}

#################################################
# trymodule replacement (test out node/ts pkgs)
#################################################

_try_module () {
  local _pwd
  local _dir
  local _called_command

  _pwd="$(pwd)"
  _dir="$(mktemp -d)"
  _called_command="$funcstack[2]"

  cd "$_dir" || exit 1

  echo "Calling try_module via $_called_command..."
  echo "with packages: $*"

  pnpm init >/dev/null
  pnpm add "$@"

  if [[ $_called_command == "trytsx" ]]; then
    pnpm add tsx
    pnpm exec tsx
  elif [[ $_called_command == "trynpx" ]]; then
    node
  fi

  # return to initial working directory
  cd "$_pwd" || exit 1

  echo "\n-------"
  echo "Exiting $_called_command..."
  echo "Deleting temp directory: $_dir"
  rm -rf "$_dir"
}

trynpx () {
  _try_module "$@"
}

trytsx () {
  _try_module "$@"
}

