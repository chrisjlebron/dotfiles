###############################################################################
### zsh/bash shared setup
###############################################################################


###############################################################################
### user bootstrap

if [ -r "$HOME/.extra" ]; then
    # shellcheck disable=SC1091
    source "$HOME/.extra"
fi

### end user bootstrap
###############################################################################


###############################################################################
### command history

# Establish one history policy before fzf and Deja initialize from .eval.
# Keep deeper history in long-running shells while limiting persisted history.
export HISTSIZE=200000

# bash specific history settings
if [ -n "${BASH_VERSION:-}" ]; then
    # timestamps for later analysis. www.debian-administration.org/users/rossen/weblog/1
    export HISTTIMEFORMAT='%F %T '

    # keep history up to date, across sessions, in realtime
    #  http://unix.stackexchange.com/a/48113
    export HISTCONTROL=ignoredups:erasedups # no duplicate entries
    export HISTFILESIZE=100000
    shopt -s histappend # append history instead of overwriting it

    # Save and reload history after each command finishes.
    # NOTE: [up] traverses shared history rather than only this session.
    export PROMPT_COMMAND="history -a; history -c; history -r; ${PROMPT_COMMAND:-}"
fi

# zsh specific history settings
if [ -n "${ZSH_VERSION:-}" ]; then
    export HISTFILE="$HOME/.zsh_history"
    export SAVEHIST=100000

    # SHARE_HISTORY handles incremental writes and imports from other shells.
    unsetopt INC_APPEND_HISTORY INC_APPEND_HISTORY_TIME
    setopt SHARE_HISTORY
    setopt HIST_IGNORE_ALL_DUPS
    setopt HIST_IGNORE_SPACE
    setopt HIST_FIND_NO_DUPS
    setopt HIST_REDUCE_BLANKS
fi

### end command history
###############################################################################


###############################################################################
### source dotfiles

# Load our dotfiles like ~/.bash_prompt, etc…
# NOTE: this is the load order, so add needed commands etc. earlier
for file in ~/.{exports,exports-dynamic,eval,aliases,functions}; do
    # shellcheck disable=SC1090
    [ -r "$file" ] && source "$file"
done
unset file

### end source dotfiles
###############################################################################
